# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@footindex.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Google AdSense (optional — enable after approval)
# Client ID from AdSense → Account → Settings (ca-pub-…)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Publisher ID for ads.txt (pub-… — same numeric ID without ca- prefix)
ADSENSE_PUBLISHER_ID=
# Ad unit slot IDs — create units in AdSense dashboard, one per placement
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_PLAYER=
NEXT_PUBLIC_ADSENSE_SLOT_COMPARE=
NEXT_PUBLIC_ADSENSE_SLOT_NEWS=
NEXT_PUBLIC_ADSENSE_SLOT_RANKINGS=

# AI summaries (optional — template fallback when unset)
OPENAI_API_KEY=

# Auth (Phase 7) — in Supabase Dashboard:
# Authentication → URL Configuration
#   Site URL: https://www.footindex.org (production)
#   Redirect URLs: https://www.footindex.org/auth/callback
# Authentication → Sign In / Providers → Email (enabled by default)
# Optional Google: enable in Supabase, then set NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Free plan: 2022–2024. Default 2024.
API_FOOTBALL_SEASON=2024

# Sync / admin protection (Phase 3)
# Generate with: openssl rand -hex 32
# Do NOT leave empty — required for POST /api/sync and /api/players/catalog
CRON_SECRET=
