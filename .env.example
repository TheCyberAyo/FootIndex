# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@haalandvsmbappe.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# AI summaries (optional — template fallback when unset)
OPENAI_API_KEY=

# Auth (Phase 7) — in Supabase Dashboard:
# Authentication → URL configuration
#   Site URL: http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback
# Enable Email (magic link) + Google provider

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Free plan: 2022–2024. Default 2024.
API_FOOTBALL_SEASON=2024

# Sync / admin protection (Phase 3)
# Generate with: openssl rand -hex 32
# Do NOT leave empty — required for POST /api/sync and /api/players/catalog
CRON_SECRET=
